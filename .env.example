# Copy to .env.local and fill in values. Never commit .env.local.
# Variables are validated at runtime by src/config/env.ts.

# --- App ---
APP_URL=http://localhost:3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Database (PostgreSQL 18) ---
# Application role and databases. `npm run db:create` creates them if missing.
DATABASE_URL=postgres://kaamico:change-me@localhost:5432/kaamico_dev
DATABASE_URL_TEST=postgres://kaamico:change-me@localhost:5432/kaamico_test
# Superuser connection used ONLY by `npm run db:create` (role/database/extension setup).
DATABASE_ADMIN_URL=postgres://postgres:your-postgres-password@localhost:5432/postgres

# --- Auth ---
# Keys OTP hashes. Required in production (min 32 chars), e.g. `openssl rand -base64 48`.
AUTH_SECRET=
# Proxies in front of the app that append to X-Forwarded-For (1 behind a typical host's load
# balancer, 2 with a CDN in front of that). Rate limits use the client address they saw.
TRUSTED_PROXY_HOPS=1
# Scales all rate limits. Keep 1 in production; 20 helps local/E2E testing.
RATE_LIMIT_MULTIPLIER=1
# Password given to the seeded admin accounts by `npm run db:seed` (random if empty).
SEED_ADMIN_PASSWORD=

# --- Simulation switches (see IMPLEMENTATION_PLAN.md §13) ---
# simulated | msg91
OTP_MODE=simulated
# simulated | razorpay
PAYMENTS_MODE=simulated
# Razorpay TEST mode keys (Dashboard → Settings → API keys / Webhooks). Live keys are refused.
# Webhook URL: <APP_URL>/api/v1/webhooks/razorpay with events payment.captured, payment.failed,
# refund.processed and refund.failed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only for public demos: allow simulated modes when NODE_ENV=production.
ALLOW_SIMULATION_IN_PRODUCTION=false
# Serve the /dev/* UI gallery in a production build (CI sets it for the accessibility scan).
ENABLE_UI_GALLERY=false

# --- Error reporting (Sentry; optional) ---
# Server errors. Reports are scrubbed of phone numbers, emails, cookies and request bodies.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Browser errors (read at build time).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Live updates ---
# sse: pages update the moment something changes (needs long-lived requests); poll: refresh on a timer only.
REALTIME_MODE=sse

# --- Storage ---
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_DRIVER=s3: a PRIVATE bucket (AWS S3 ap-south-1, Cloudflare R2 or MinIO). Files are only
# ever served through the app, so the bucket needs no public access and no CORS.
S3_ENDPOINT=
S3_BUCKET=
# "auto" for R2, e.g. ap-south-1 for AWS.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for R2 and MinIO; false for AWS virtual-hosted URLs.
S3_FORCE_PATH_STYLE=true

# --- Marketplace ---
# Platform commission in basis points (1000 = 10%).
COMMISSION_BPS=1000

# --- Internal jobs ---
# Shared secret for /api/internal/* cron routes (min 32 chars). Optional in development.
CRON_SECRET=
